// Load with --config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  -> "
    },
    
    "logo": {
	"source": "~/.config/fastfetch/punpun.txt",
	"color": {
		"1": "bright_blue"
	},
    },

    "modules": [
	
        {
            "type": "title",
            "format": "- {user-name}@{host-name} -",
        },

        {
            "type": "os",
            "key": "{icon}", // Just get your distro's logo off nerdfonts.com
            "keyColor": "yellow"
        },

        {
            "type": "kernel",
            "key": "",
            "keyColor": "yellow"
        },

        {
            "type": "uptime",
            "key": "󰅐",
            "keyColor": "yellow"
        },

        {
            "type": "packages",
            "key": "󰏖",
            "keyColor": "yellow"
        },

        {
            "type": "shell",
            "key": "",
            "keyColor": "yellow"
        },

        {
            "type": "wm",
            "key": "",
            "keyColor": "yellow"
        },

        {
            "type": "terminal",
            "key": "",
            "keyColor": "yellow"
        },

        {
            "type": "terminalfont",
            "key": "",
            "keyColor": "yellow"
        },

        {
            "type": "cpu",
            "key": "󰻠",
            "keyColor": "yellow"
        },

        {
            "type": "display",
            "key": "󰍹",
            "keyColor": "yellow"
        },

	"break",

	{
	    "type": "colors",
	    "key": " "
	},

	"break",

    ]
}
