-- Conky, a system monitor https://github.com/brndnmtthws/conky
--
-- This configuration file is Lua code. You can write code in here, and it will
-- execute when Conky loads. You can use it to generate your own advanced
-- configurations.
--
-- Try this (remove the `--`):
--
--   print("Loading Conky config")
--
-- For more on Lua, see:
-- https://www.lua.org/pil/contents.html
--
-- Conky Lua API: https://conky.cc/lua

-- Configuration settings: https://conky.cc/config_settings

-- This Configuration Made By Nucofu

conky.config = {

-- === Windows Section ===

    own_window = true,
    own_window_class = 'Conky',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 153,
    own_window_colour = '1e1e2e',
    own_window_type = 'override',
    own_window_hints = 'undecorated,sticky,below,skip_taskbar,skip_pager',

    minimum_height = 200,
    minimum_width = 200,
    maximum_width == 400,
    gap_x = 25,
    gap_y = 25,
    
    alignment = 'top_left',
    update_interval = 1.0,

-- === Font Section ===

    font = 'Iosevka Nerd Font:style=bold:size=10',

    use_xft = true,
    uppercase = false,
    use_spacer = 'none',

-- === Color Section ===

    default_color = '#282828',
    color0 = 'white',
    color1 = "#199aff",
    color2 = "#19bcff",

-- === Outline & Shades ===

    draw_outline = false,
    default_outline_color = 'black',

    draw_shades = false,
    default_shade_color = '#383838',

-- === Borders ===

    draw_borders = true,
    default_borders_color = '#282828',
    border_width = 2,
    draw_graph_borders = true,
    stippled_borders = 0,
    border_outer_margin = 0,
    border_inner_margin = 8,

-- === Buffers ===

    double_buffer = true,
    no_buffers = true,

-- === Others ===

    cpu_avg_samples = 2,
    net_avg_samples = 2,

}

-- === Variables: https://conky.cc/variables ===

conky.text = [[
${color1}Info:$color0 Void $kernel ($nodename) ($machine)
${color}$hr
${color1}System Performance
${color2}  Uptime:$color0 $uptime
${color2}  Frequency:$color0 ${freq}MHz or$color0 ${freq_g}GHz
${color2}  CPU Usage:$color0 $cpu% ${cpubar 4}
${color2}  RAM Usage:$color0 $mem/$memmax - $memperc% ${membar 4}
${color2}  Swap Usage:$color0 $swap/$swapmax - $swapperc% ${swapbar 4}
${color2}  Processes:$color0 $processes  ${color1}Running:$color0 $running_processes
${color}$hr
#${color1}Name               PID     CPU%   MEM%
#${color2} ${top name 1} ${color0}${top pid 1} ${top cpu 1} ${top mem 1}
#${color2} ${top name 2} ${color0}${top pid 2} ${top cpu 2} ${top mem 2}
#${color2} ${top name 3} ${color0}${top pid 3} ${top cpu 3} ${top mem 3}
#${color2} ${top name 4} ${color0}${top pid 4} ${top cpu 4} ${top mem 4}
#$hr
${color1}File systems:
 / $color0${fs_used /}/${fs_size /} ${fs_bar 6 /}
${color}$hr
${color1}Shortcut
${color2} connman-ui     :$color0 win + i
${color2} PCMan FM       :$color0 win + f
${color2} st             :$color0 win + t
${color2} waterfox       :$color0 win + w
${color2} onlyoffice     :$color0 win + o
${color2} mgba           :$color0 win + g
${color2} emacs          :$color0 win + e
${color}$hr
]]
