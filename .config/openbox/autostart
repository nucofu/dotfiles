# run compositor
picom -b &

# set wallpaper
nitrogen --restore --force-setter=xwindows &

# set lemonbar
$HOME/.config/selfScript/statusBar.sh wlp2s0 &

# battery notification
$HOME/.config/selfScript/battery.sh &

# set conky
conky -c ~/.config/conky/clock.conkyrc --pause=1 &
conky -c ~/.config/conky/sp.conkyrc --pause=1 &

# set color temperature
sct 3333 &

# set audio
pipewire &

# set automount
udiskie &

# screenlock
#xss-lock -- slock &
